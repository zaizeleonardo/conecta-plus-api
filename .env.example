# Copie para .env e preencha com seus valores. O arquivo .env NÃO deve ser versionado.

# Usado pela execução local (fora do Docker)
DB_URL=jdbc:mysql://localhost:3306/conecta_plus?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
DB_USERNAME=root

# Usado pelo Docker Compose e pela execução local
DB_PASSWORD=troque-esta-senha

# Chave do JWT: pelo menos 32 caracteres (256 bits) para HS256
JWT_SECRET=troque-por-uma-chave-aleatoria-com-32-caracteres-ou-mais
